ENVIRONMENT=local
PORT=8000
DATABASE_URL=postgresql+asyncpg://pharmagent:pharmagent_pass@127.0.0.1:5433/pharmagent_db
OLLAMA_BASE_URL=http://localhost:11434
CIMA_BASE_URL=https://cima.aemps.es/cima/rest
EMBEDDING_PROVIDER=ollama
GOOGLE_API_KEY=tu_api_key_de_gemini_aqui
SENTRY_DSN=

# Generación de texto de RAGPharmAgent/SafetyCheckAgent vía Groq (respuesta <2s) en vez
# de Ollama local por CPU (~30s). Los embeddings NO usan Groq: siguen en Ollama local
# (OLLAMA_BASE_URL de arriba) por privacidad de datos de salud. Sin GROQ_API_KEY, la
# generación degrada a texto vacío en vez de fallar (ver GroqClient).
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=tu_api_key_de_groq_aqui
GROQ_MODEL=llama-3.1-8b-instant

# La API REST no requiere autenticación: se sirve abierta para consumo del frontend local
# (Streamlit) — ver .memory/DECISIONS.md, "API REST abierta para consumo local".

# Orígenes permitidos por CORS, como lista JSON. `["*"]` es apropiado para desarrollo local.
CORS_ALLOWED_ORIGINS=["*"]