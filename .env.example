ENVIRONMENT=local
PORT=8000
DATABASE_URL=postgresql+asyncpg://pharmagent:pharmagent_pass@127.0.0.1:5433/pharmagent_db
# `false` (por defecto) para el Postgres de docker-compose.yml, que no ofrece SSL. Un
# Postgres gestionado en un proveedor de despliegue normalmente lo exige: poner `true` ahí.
DATABASE_SSL=false
OLLAMA_BASE_URL=http://localhost:11434
CIMA_BASE_URL=https://cima.aemps.es/cima/rest
EMBEDDING_PROVIDER=ollama
GOOGLE_API_KEY=tu_api_key_de_gemini_aqui
SENTRY_DSN=

# Generación de texto de RAGPharmAgent/SafetyCheckAgent vía Groq (respuesta <2s) en vez
# de Ollama local por CPU (~30s). Los embeddings NO usan Groq: siguen en Ollama local
# (OLLAMA_BASE_URL de arriba) por privacidad de datos de salud. Sin GROQ_API_KEY, la
# generación degrada a texto vacío en vez de fallar (ver GroqClient).
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=tu_api_key_de_groq_aqui
GROQ_MODEL=llama-3.1-8b-instant

# Vacío/ausente (por defecto) = autenticación desactivada, apropiado para desarrollo local
# (el frontend y la API corren en la misma máquina). Poner un valor activa la comprobación
# de la cabecera `X-API-Key` en pharmacy_router — necesario antes de exponer la API a
# Internet. El frontend debe recibir el mismo valor en su propio `VITE_API_KEY`
# (frontend/.env.example).
API_KEY=

# Límite de peticiones por IP en pharmacy_router (formato "<cantidad>/<periodo>" de
# slowapi/limits). Protege de abuso/coste descontrolado en Groq/Gemini si la API queda
# expuesta públicamente. 5/minute es deliberadamente bajo (proyecto demo/portfolio, no un
# servicio con tráfico real esperado) — subirlo si el uso legítimo empieza a chocar con él.
RATE_LIMIT=5/minute

# Orígenes permitidos por CORS, como lista JSON. `["*"]` es apropiado para desarrollo local;
# en un despliegue público, restringir al dominio real del frontend, p. ej.
# CORS_ALLOWED_ORIGINS=["https://pharmagent.vercel.app"]
CORS_ALLOWED_ORIGINS=["*"]

# `false` (por defecto) para desarrollo local. En el despliegue público, poner `true` junto
# con `VITE_DEMO_MODE=true` en el frontend (frontend/.env.example): el backend entonces
# rechaza (403) cualquier imagen subida a /analyze-prescription o /process-prescription que
# no sea uno de los 3 ejemplos sintéticos incluidos, aunque se llame a la API directamente
# sin pasar por la UI. Ver docs/adr/002-datos-personales-foto-receta.md.
DEMO_MODE=false