ENVIRONMENT=local
PORT=8000
DATABASE_URL=postgresql+asyncpg://pharmagent:pharmagent_pass@127.0.0.1:5433/pharmagent_db
OLLAMA_BASE_URL=http://localhost:11434
CIMA_BASE_URL=https://cima.aemps.es/cima/rest
EMBEDDING_PROVIDER=ollama
GOOGLE_API_KEY=tu_api_key_de_gemini_aqui
SENTRY_DSN=

# Autenticación de la API REST (cabecera X-API-Key). Vacío/ausente = autenticación
