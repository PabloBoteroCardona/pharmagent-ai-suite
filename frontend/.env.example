VITE_API_BASE_URL=http://localhost:8000

# "true" solo en el despliegue público: restringe la pestaña de Receta a 3 imágenes de
# ejemplo sintéticas (frontend/public/samples/) en vez de aceptar fotos reales de
# desconocidos — ver README.md, "Descripción y objetivos", sobre por qué. Déjalo vacío/sin
# definir en local para seguir pudiendo subir tus propias fotos de prueba.
VITE_DEMO_MODE=

# Debe coincidir exactamente con `API_KEY` del backend (.env.example de la raíz) en el
# despliegue público. Déjalo vacío en local si el backend tampoco tiene `API_KEY` puesta.
# Nota: al vivir en el bundle del frontend, no es un secreto real (ver api.ts) — frena abuso
# anónimo, no sustituye una autenticación de usuarios.
VITE_API_KEY=
